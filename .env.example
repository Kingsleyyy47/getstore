# --- Supabase (get these from your Supabase project settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only, NEVER expose this to the browser. Used for wallet/rental
# mutations that must bypass RLS under controlled, server-checked conditions.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- DaisySMS (server-only, from https://daisysms.io/dashboard/profile) ---
# Powers the "Numbers" page.
DAISYSMS_API_KEY=your_daisysms_api_key
DAISYSMS_BASE_URL=https://daisysms.io/stubs/handler_api.php

# --- DaisySim (server-only, from your DaisySim dashboard's Profile page) ---
# One DaisySim account, two products -- both read this same API key.
# DAISYSIM_API_KEY powers BOTH:
#   - the original /virtual API ("All Countries" page)
#   - the server7 API ("US Only" page, a separate product from the same
#     company -- not a replacement, and not a separate key)
DAISYSIM_API_KEY=your_daisysim_api_key
DAISYSIM_BASE_URL=https://daisysim.com/api/v1/virtual
DAISYSIM2_BASE_URL=https://daisysim.com/api/v1/server7

# Percentage markup applied on top of each provider's USD price when
# charging customers. 20 = customers pay 20% more than the provider's price.
MARKUP_PERCENT=20

# --- PocketFi (server-only, from your PocketFi business dashboard) ---
# Powers automated wallet top-ups: hosted checkout links + dedicated virtual
# accounts (see supabase/009_pocketfi.sql). Toggled on/off from
# Admin -> Settings via app_settings.pocketfi_enabled, same as the other
# providers -- manual top-ups keep working either way.
#
# PocketFi's key naming is the reverse of what you'd expect:
#   - "Public API Key" is the one that actually authenticates API calls --
#     a Laravel Sanctum-style `id|token` credential (looks like
#     `1|abc123xyz...`). That's POCKETFI_PUBLIC_KEY below.
#   - "Secret API Key" is just a hex string, and its ONLY use is verifying
#     the HMAC-SHA512 signature on incoming webhooks -- it is NOT a valid
#     bearer token. That's POCKETFI_SECRET_KEY below.
POCKETFI_BUSINESS_ID=your_pocketfi_business_id
POCKETFI_PUBLIC_KEY=your_pocketfi_public_api_key
POCKETFI_SECRET_KEY=your_pocketfi_secret_api_key
POCKETFI_BASE_URL=https://api.pocketfi.ng
# On PocketFi's dashboard, set the webhook URL to:
#   https://getstore.org/api/webhooks/pocketfi

# The USD->NGN exchange rate and the per-provider enable/disable toggles are
# NOT env vars -- they're stored in the app_settings table and edited live
# from Admin -> Settings (see supabase/003_settings.sql, 004_daisysim.sql,
# and 005_daisysim2.sql).

# --- Auto-cancel cron (rentals with no code after 7 minutes) ---
# Authorizes calls to /api/cron/auto-cancel-rentals, which cancels+refunds
# any DaisySMS/DaisySim/DaisySim2 rental that's been waiting 7+ minutes with
# no code (confirming the cancellation with the provider first -- see that
# route's comments). Generate any random secret and set it here AND in your
# hosting provider's env vars.
#   - On Vercel: vercel.json already has a `crons` entry hitting this route
#     every 5 minutes -- Vercel automatically sends
#     `Authorization: Bearer $CRON_SECRET` on those scheduled requests.
#   - Elsewhere: point an external scheduler (cron-job.org, a GitHub Actions
#     scheduled workflow, etc.) at https://getstore.org/api/cron/auto-cancel-rentals
#     every few minutes, sending that same header yourself.
CRON_SECRET=your_random_secret
