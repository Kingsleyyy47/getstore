# --- Supabase (get these from your Supabase project settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only, NEVER expose this to the browser. Used for wallet/rental
# mutations that must bypass RLS under controlled, server-checked conditions.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- DaisySMS (server-only, from https://daisysms.io/dashboard/profile) ---
# Powers the "Numbers" page.
DAISYSMS_API_KEY=your_daisysms_api_key
DAISYSMS_BASE_URL=https://daisysms.io/stubs/handler_api.php

# --- DaisySim (server-only, from your DaisySim dashboard's Profile page) ---
# One DaisySim account, two products -- both read this same API key.
# DAISYSIM_API_KEY powers BOTH:
#   - the original /virtual API ("All Countries" page)
#   - the server7 API ("US Only" page, a separate product from the same
#     company -- not a replacement, and not a separate key)
DAISYSIM_API_KEY=your_daisysim_api_key
DAISYSIM_BASE_URL=https://daisysim.com/api/v1/virtual
DAISYSIM2_BASE_URL=https://daisysim.com/api/v1/server7

# Percentage markup applied on top of each provider's USD price when
# charging customers. 20 = customers pay 20% more than the provider's price.
MARKUP_PERCENT=20

# The USD->NGN exchange rate and the per-provider enable/disable toggles are
# NOT env vars -- they're stored in the app_settings table and edited live
# from Admin -> Settings (see supabase/003_settings.sql, 004_daisysim.sql,
# and 005_daisysim2.sql).
